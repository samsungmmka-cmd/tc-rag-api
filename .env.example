# ---------- Service
LOG_LEVEL=INFO
# Bearer tokens. ADMIN uploads / deletes (and can read). READ is for the validation agent:
# set the agent's RAG_API_KEY to this value. Leave both empty only for local experiments.
API_ADMIN_TOKEN=change-me-admin-token
API_READ_TOKEN=change-me-read-token

# ---------- Qdrant
# docker compose overrides QDRANT_URL to http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant-dev-key
QDRANT_COLLECTION=tc_chunks
QDRANT_REGISTRY_COLLECTION=tc_registry

# ---------- Redis: per-campaign upload lock (works across several API instances).
# Empty = in-process lock, fine for a single instance. docker compose sets it.
REDIS_URL=redis://:redis-dev-pass@redis:6379/0
LOCK_TTL_SECONDS=600

# ---------- Embeddings: any OpenAI-compatible /embeddings endpoint
# EMBED_MODE=hash runs without an API key (dev only: matches words, not meaning).
EMBED_MODE=openai
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
# true: send "dimensions" to shrink text-embedding-3 vectors (e.g. EMBED_DIM=512)
EMBED_SEND_DIMENSIONS=false
EMBED_BATCH_SIZE=64
EMBED_TIMEOUT=60
EMBED_MAX_RETRIES=4

# ---------- Chunking (tokens are estimated at ~4 characters per token)
CHUNK_MAX_TOKENS=700
# 0 recommended: the agent reads every chunk, so overlap would show the same rule twice
CHUNK_OVERLAP_TOKENS=0
# Tables above this are split by rows; every part repeats the header row
TABLE_MAX_TOKENS=900

# ---------- Upload
MAX_UPLOAD_MB=20
